# TGF's own operational state — telemetry, evolution proposals,
# and session logs from TGF's own development.
# Framework infrastructure (registry, org-mapping, schemas) is tracked;
# per-machine/per-session state (hashes, baselines, research-logs, approvals,
# overrides, parameter-history, debug log) is gitignored.
.tgf/*
!.tgf/state/
.tgf/state/*
!.tgf/state/source-registry.json
!.tgf/state/source-org-mapping.json
!.tgf/state/source-schemas/
!.tgf/state/source-schemas/*.json
.sessions/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log

# Python bytecode (research-security hooks under .claude/hooks/lib/ are Python)
__pycache__/
*.pyc
*.pyo

# Local environment
.env
.env.local
